<Window x:Class="ComputerRepairShopManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Computer Repair Shop - Backend Testing"
        Height="850"
        Width="1200"
        MinHeight="650"
        MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="12">
        <DataGrid x:Name="RepairRequestsGrid"
          Height="200"
          AutoGenerateColumns="True"
          IsReadOnly="True"
          CanUserAddRows="False"
          AutoGeneratingColumn="RepairRequestsGrid_AutoGeneratingColumn"/>
    </Grid>
</Window>
